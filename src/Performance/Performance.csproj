<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Performance</AssemblyName>
    <RootNamespace>Performance</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType>portable</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildProjectDirectory)\..\..</GameDir>
    <ManagedDir>$(GameDir)\Scam With Your Friends_Data\Managed</ManagedDir>
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(BepInExDir)\core\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExDir)\core\0Harmony.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.AnimationModule" HintPath="$(ManagedDir)\UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(ManagedDir)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.ParticleSystemModule" HintPath="$(ManagedDir)\UnityEngine.ParticleSystemModule.dll" Private="false" />
    <Reference Include="UnityEngine.VideoModule" HintPath="$(ManagedDir)\UnityEngine.VideoModule.dll" Private="false" />
    <Reference Include="UnityEngine.AudioModule" HintPath="$(ManagedDir)\UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="UnityEngine.UIElementsModule" HintPath="$(ManagedDir)\UnityEngine.UIElementsModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(ManagedDir)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(ManagedDir)\UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="Unity.InputSystem" HintPath="$(ManagedDir)\Unity.InputSystem.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(ManagedDir)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(ManagedDir)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="Unity.RenderPipelines.Core.Runtime" HintPath="$(ManagedDir)\Unity.RenderPipelines.Core.Runtime.dll" Private="false" />
    <Reference Include="Unity.RenderPipelines.Universal.Runtime" HintPath="$(ManagedDir)\Unity.RenderPipelines.Universal.Runtime.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(ManagedDir)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="ScriptsAssDef" HintPath="$(ManagedDir)\ScriptsAssDef.dll" Private="false" />
    <Reference Include="Metater" HintPath="$(ManagedDir)\Metater.dll" Private="false" />
    <Reference Include="Mirror" HintPath="$(ManagedDir)\Mirror.dll" Private="false" />
    <Reference Include="Mirror.Components" HintPath="$(ManagedDir)\Mirror.Components.dll" Private="false" />
    <Reference Include="QuickOutline" HintPath="$(ManagedDir)\QuickOutline.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(ManagedDir)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.ScreenCaptureModule" HintPath="$(ManagedDir)\UnityEngine.ScreenCaptureModule.dll" Private="false" />
    <Reference Include="UnityEngine.DirectorModule" HintPath="$(ManagedDir)\UnityEngine.DirectorModule.dll" Private="false" />
    <Reference Include="Unity.RenderPipelines.Core.Runtime.Shared" HintPath="$(ManagedDir)\Unity.RenderPipelines.Core.Runtime.Shared.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Icons.bin" LogicalName="Performance.Icons.bin" />
    <None Remove="tools\**" />
    <Compile Remove="tools\**" />
  </ItemGroup>

  <Target Name="CopyToPlugins" AfterTargets="Build">
    <MakeDir Directories="$(GameDir)\Mods;$(GameDir)\Mods\$(AssemblyName)" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb;mod.json" DestinationFolder="$(GameDir)\Mods\$(AssemblyName)" Condition="Exists('mod.json')" />
  </Target>

</Project>
