<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the Arkáda games outside Unity with a scripted player and saves frames as PNG.
       Build Arcade first, then: dotnet run -c Release (project folder ModSource/Arcade/tools/ArcadeTest), output folder as argument. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <GameDir>$(MSBuildProjectDirectory)\..\..\..\..</GameDir>
    <ManagedDir>$(GameDir)\Scam With Your Friends_Data\Managed</ManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Drawing" />
    <Reference Include="Arcade" HintPath="..\..\bin\Release\Arcade.dll" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)\UnityEngine.CoreModule.dll" />
    <Reference Include="Unity.InputSystem" HintPath="$(ManagedDir)\Unity.InputSystem.dll" />
  </ItemGroup>

</Project>
