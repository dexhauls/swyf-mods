<Window x:Class="SwyfInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SwyfInstaller"
        Title="SWYF Mod Hub" Width="960" Height="720"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" AllowDrop="True"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        DragEnter="OnDragEnter" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">

    <Window.Resources>
        <Style x:Key="Spinner" TargetType="Path">
            <Setter Property="Stroke" Value="{StaticResource Accent}" />
            <Setter Property="StrokeThickness" Value="3" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Data" Value="M 12,2 A 10,10 0 1 1 2,12" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="RenderTransform">
                <Setter.Value><RotateTransform /></Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsVisible" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{StaticResource SurfacePressed}" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="20" />
        </Style>

        <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="Padding" Value="6,2" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#14FFC23D" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Task row (install progress) -->
        <DataTemplate x:Key="TaskTemplate">
            <Border CornerRadius="10" Background="{StaticResource Surface}" Padding="14,11" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StateIcon" Style="{StaticResource Icon}" Text="&#xEA3A;" FontSize="14" Foreground="{StaticResource TrackOff}" />
                    <Path x:Name="StateSpinner" Style="{StaticResource Spinner}" Width="15" Height="15" StrokeThickness="2.2" Visibility="Collapsed" />
                    <TextBlock x:Name="TaskTitle" Grid.Column="1" Text="{Binding Title}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMuted}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Running">
                    <Setter TargetName="StateIcon" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="StateSpinner" Property="Visibility" Value="Visible" />
                    <Setter TargetName="TaskTitle" Property="Foreground" Value="{StaticResource Text}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Done">
                    <Setter TargetName="StateIcon" Property="Text" Value="&#xE73E;" />
                    <Setter TargetName="StateIcon" Property="Foreground" Value="{StaticResource Success}" />
                    <Setter TargetName="TaskTitle" Property="Foreground" Value="{StaticResource Text}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Mod card -->
        <DataTemplate DataType="{x:Type local:ModCard}">
            <Border x:Name="Card" Width="410" Margin="0,0,16,16" CornerRadius="14" Padding="18,16"
                    Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}" BorderThickness="1.5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="IconTile" Width="46" Height="46" CornerRadius="12" Background="{StaticResource SurfacePressed}">
                            <TextBlock x:Name="IconGlyph" Style="{StaticResource Icon}" Text="{Binding IconGlyph}" FontSize="22" Foreground="{StaticResource TextMuted}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="15.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <CheckBox x:Name="Toggle" Grid.Column="2" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                  IsChecked="{Binding Enabled, Mode=OneWay}" Click="OnToggleMod" Tag="{Binding}" />
                        <Border x:Name="LockChip" Grid.Column="2" Style="{StaticResource Chip}" Margin="0" Visibility="Collapsed" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,6,0" />
                                <TextBlock Text="{DynamicResource S.Required}" FontSize="11.5" Foreground="{StaticResource TextMuted}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="12.5" Foreground="{StaticResource TextMuted}"
                               TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="18" />
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ItemsControl ItemsSource="{Binding Tags}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Chip}">
                                        <TextBlock Text="{Binding}" FontSize="11.5" Foreground="{StaticResource Text}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource TrackOff}" Margin="0,0,7,0" />
                            <TextBlock x:Name="StatusLine" Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource TextMuted}" />
                        </StackPanel>
                        <Button x:Name="RemoveButton" Grid.Column="2" Style="{StaticResource IconButton}" Width="30" Height="30" Margin="8,0,-6,0"
                                ToolTip="{DynamicResource S.RemoveMod}" Click="OnRemoveMod" Tag="{Binding}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Enabled}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="#66FFC23D" />
                    <Setter TargetName="IconTile" Property="Background" Value="{StaticResource Accent}" />
                    <Setter TargetName="IconGlyph" Property="Foreground" Value="{StaticResource AccentDark}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Running">
                    <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource Success}" />
                    <Setter TargetName="StatusLine" Property="Foreground" Value="{StaticResource Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="On">
                    <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Error">
                    <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource Danger}" />
                    <Setter TargetName="StatusLine" Property="Foreground" Value="{StaticResource Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Locked}" Value="True">
                    <Setter TargetName="Toggle" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="LockChip" Property="Visibility" Value="Visible" />
                    <Setter TargetName="RemoveButton" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- "Add mod" card -->
        <DataTemplate DataType="{x:Type local:AddCard}">
            <Grid Width="410" MinHeight="150" Margin="0,0,16,16" Cursor="Hand" MouseLeftButtonUp="OnAddModClick" Background="Transparent">
                <Rectangle x:Name="Dash" RadiusX="14" RadiusY="14" Stroke="#40FFFFFF" StrokeThickness="1.5" StrokeDashArray="5 4" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="46" Height="46" CornerRadius="23" Background="#1AFFC23D" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="20" Foreground="{StaticResource Accent}" />
                    </Border>
                    <TextBlock Text="{DynamicResource S.AddMod}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" />
                    <TextBlock Text="{DynamicResource S.AddModHint}" FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Dash" Property="Stroke" Value="{StaticResource Accent}" />
                    <Setter TargetName="Dash" Property="Fill" Value="#0DFFC23D" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Download choice in the install dialog -->
        <DataTemplate x:Key="DownloadTemplate">
            <Border CornerRadius="10" Background="{StaticResource SurfacePressed}" Padding="14,10" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SizeText}" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="8,1,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,2,12,0" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" IsChecked="{Binding Selected, Mode=TwoWay}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="22">
        <Border CornerRadius="18" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.6" Color="Black" />
            </Border.Effect>
        </Border>

        <Grid x:Name="ContentRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="160" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header: the game's Steam artwork + logo -->
            <Grid Grid.Row="0" Background="#0C0E12" MouseLeftButtonDown="OnDrag">
                <Image x:Name="HeroImage" Stretch="UniformToFill" VerticalAlignment="Center" Opacity="0.55" />
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#F2111318" Offset="0" />
                            <GradientStop Color="#99111318" Offset="0.55" />
                            <GradientStop Color="#40111318" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00111318" Offset="0.45" />
                            <GradientStop Color="#FF111318" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="34,0,0,0">
                    <Image x:Name="LogoImage" Height="108" Margin="0,4,0,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <Border x:Name="LogoFallback" Width="64" Height="64" CornerRadius="16" Background="{StaticResource Accent}" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" FontSize="32" Foreground="{StaticResource AccentDark}" />
                    </Border>
                    <Rectangle Width="1" Height="64" Fill="#30FFFFFF" Margin="26,0,22,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Mod Hub" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock x:Name="VersionText" FontSize="12.5" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0">
                    <Button Style="{StaticResource IconButton}" Click="OnMinimize" ToolTip="{DynamicResource S.Minimize}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE921;" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="OnClose" ToolTip="{DynamicResource S.Close}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8BB;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>

            <StackPanel x:Name="Stepper" Grid.Row="1" Orientation="Horizontal" Margin="36,4,36,0" />

            <Grid Grid.Row="2" Margin="36,24,36,26">

                <!-- 1) Find the game -->
                <Grid x:Name="PageFind">
                    <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="540">
                        <Grid Width="72" Height="72" HorizontalAlignment="Center">
                            <Ellipse x:Name="FindRing" Fill="#14FFC23D" />
                            <Path x:Name="FindSpinner" Style="{StaticResource Spinner}" Width="38" Height="38" />
                            <TextBlock x:Name="FindIcon" Style="{StaticResource Icon}" FontSize="30" Visibility="Collapsed" />
                        </Grid>
                        <TextBlock x:Name="FindTitle" Style="{StaticResource PageTitle}" HorizontalAlignment="Center" Margin="0,20,0,0" />
                        <TextBlock x:Name="FindSubtitle" Style="{StaticResource PageSubtitle}" HorizontalAlignment="Center" TextAlignment="Center" />
                        <Border x:Name="FindPathCard" CornerRadius="12" Background="{StaticResource Surface}" Padding="16,12" Margin="0,22,0,0" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Foreground="{StaticResource TextMuted}" />
                                <TextBlock x:Name="FindPath" Grid.Column="1" Margin="12,0,0,0" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>
                        <Button x:Name="FindPickButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,22,0,0" Click="OnPickFolder" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="15" Margin="0,0,9,0" Foreground="{StaticResource AccentDark}" />
                                <TextBlock Text="{DynamicResource S.PickFolder}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 2) Base: mod loader + Mod Manager (first run / update) -->
                <Grid x:Name="PageBase" Visibility="Collapsed">
                    <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="400" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="BaseTitle" Style="{StaticResource PageTitle}" />
                        <TextBlock x:Name="BaseSubtitle" Style="{StaticResource PageSubtitle}" />
                        <StackPanel Margin="0,22,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" Foreground="{StaticResource Accent}" Margin="0,0,12,0" />
                                <TextBlock Text="{DynamicResource S.Bullet1}" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Foreground="{StaticResource Accent}" Margin="0,0,12,0" />
                                <TextBlock Text="{DynamicResource S.Bullet2}" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" Foreground="{StaticResource Accent}" Margin="0,0,12,0" />
                                <TextBlock Text="{DynamicResource S.Bullet3}" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="BaseModsPanel" Margin="0,22,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="BaseModsTitle" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8" />
                            <ItemsControl x:Name="BaseModsList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Chip}" Margin="0,0,6,6" Padding="10,5">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="11" Foreground="{StaticResource Success}" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding}" FontSize="12" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                            <Button x:Name="BaseButton" Style="{StaticResource PrimaryButton}" Click="OnInstallBase">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="15" Margin="0,0,9,0" Foreground="{StaticResource AccentDark}" />
                                    <TextBlock x:Name="BaseButtonText" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BaseSkipButton" Style="{StaticResource SecondaryButton}" Padding="16,12" Margin="10,0,0,0" Click="OnSkipBase" Visibility="Collapsed"
                                    Content="{DynamicResource S.SkipForNow}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock x:Name="BasePercent" FontSize="12.5" Foreground="{StaticResource TextMuted}" Margin="2,0,0,8" />
                        <ProgressBar x:Name="BaseProgress" Style="{StaticResource ThinProgress}" Minimum="0" Maximum="1" Height="5" Margin="0,0,0,14" Visibility="Hidden" />
                        <ItemsControl x:Name="BaseTasks" ItemTemplate="{StaticResource TaskTemplate}" />
                    </StackPanel>
                </Grid>

                <!-- 3) Library -->
                <Grid x:Name="PageLibrary" Visibility="Collapsed">
                    <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource S.Library}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Ellipse x:Name="GameDot" Width="8" Height="8" Margin="1,0,8,0" />
                                <TextBlock x:Name="GameStatusText" FontSize="13" Foreground="{StaticResource TextMuted}" />
                            </StackPanel>
                            <Border x:Name="BaseOutdatedBar" CornerRadius="10" Background="#1AFFC23D" BorderBrush="#40FFC23D" BorderThickness="1"
                                    Padding="12,7" Margin="0,12,0,0" HorizontalAlignment="Left" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="13" Foreground="{StaticResource Accent}" Margin="0,0,10,0" />
                                    <TextBlock x:Name="BaseOutdatedText" FontSize="12.5" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource LinkButton}" Content="{DynamicResource S.Update}" FontSize="12.5" Margin="10,0,0,0" Click="OnOpenBase" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Border Style="{StaticResource Chip}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,0,8,0" />
                                <TextBlock x:Name="LibraryPath" FontSize="12" Foreground="{StaticResource TextMuted}" MaxWidth="280" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Button Style="{StaticResource LinkButton}" Content="{DynamicResource S.Change}" FontSize="12" Margin="8,0,0,0" Click="OnPickFolder" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <ScrollViewer Grid.Row="1" Margin="0,20,-16,0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ModList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Button Style="{StaticResource DangerGhostButton}" HorizontalAlignment="Left" Click="OnUninstallAll">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource S.UninstallAll}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource SecondaryButton}" Padding="16,11" Margin="0,0,10,0" Click="OnAddModClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="{DynamicResource S.AddMod}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="LaunchButton" Style="{StaticResource PrimaryButton}" Click="OnLaunch">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="15" Margin="0,0,9,0" Foreground="{StaticResource AccentDark}" />
                                    <TextBlock Text="{DynamicResource S.Launch}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Toast -->
            <Border x:Name="Toast" Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,84"
                    CornerRadius="12" Background="#F21B1E26" BorderBrush="{StaticResource Stroke}" BorderThickness="1" Padding="16,11" Opacity="0" IsHitTestVisible="False">
                <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ToastIcon" Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="14" Foreground="{StaticResource Success}" Margin="0,0,10,0" />
                    <TextBlock x:Name="ToastText" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Drop highlight -->
        <Grid x:Name="DropLayer" Visibility="Collapsed" IsHitTestVisible="False">
            <Rectangle RadiusX="18" RadiusY="18" Fill="#CC0C0E12" Stroke="{StaticResource Accent}" StrokeThickness="2" StrokeDashArray="6 4" Margin="10" />
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="44" Foreground="{StaticResource Accent}" />
                <TextBlock Text="{DynamicResource S.DropHere}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0" />
                <TextBlock Text="{DynamicResource S.DropHint}" FontSize="13" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <!-- Install-mod dialog -->
        <Grid x:Name="InstallLayer" Visibility="Collapsed">
            <Border CornerRadius="18" Background="#B3000000" />
            <Border Width="520" CornerRadius="16" Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                    Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.5" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="InstallHeading" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="14" Background="{StaticResource Accent}">
                            <TextBlock x:Name="PkgIcon" Style="{StaticResource Icon}" FontSize="24" Foreground="{StaticResource AccentDark}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="PkgName" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="PkgMeta" FontSize="12.5" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="PkgDescription" FontSize="13" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,14,0,0" LineHeight="19" />

                    <StackPanel x:Name="PkgChoice">
                        <StackPanel x:Name="PkgDownloadsPanel" Margin="0,18,0,0">
                            <TextBlock Text="{DynamicResource S.DownloadsHeading}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8" />
                            <ItemsControl x:Name="PkgDownloads" ItemTemplate="{StaticResource DownloadTemplate}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                            <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource S.Cancel}" Margin="0,0,10,0" Click="OnPackageCancel" />
                            <Button x:Name="PkgInstallButton" Style="{StaticResource PrimaryButton}" Padding="20,10" Click="OnPackageInstall">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="14" Margin="0,0,8,0" Foreground="{StaticResource AccentDark}" />
                                    <TextBlock x:Name="PkgInstallText" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="PkgProgressPanel" Margin="0,20,0,0" Visibility="Collapsed">
                        <Grid>
                            <TextBlock x:Name="PkgProgressLabel" FontSize="13" />
                            <TextBlock x:Name="PkgProgressDetail" FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" />
                        </Grid>
                        <ProgressBar x:Name="PkgProgress" Style="{StaticResource ThinProgress}" Minimum="0" Maximum="1" Height="6" Margin="0,10,0,4" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Generic dialog (confirmations, errors) -->
        <Grid x:Name="DialogLayer" Visibility="Collapsed">
            <Border CornerRadius="18" Background="#B3000000" />
            <Border Width="440" CornerRadius="16" Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                    Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.5" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="DialogIconTile" Width="38" Height="38" CornerRadius="10">
                            <TextBlock x:Name="DialogIcon" Style="{StaticResource Icon}" FontSize="17" />
                        </Border>
                        <TextBlock x:Name="DialogTitle" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap" MaxWidth="330" />
                    </StackPanel>
                    <TextBlock x:Name="DialogText" FontSize="13" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,14,0,0" LineHeight="19" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button x:Name="DialogCancel" Style="{StaticResource SecondaryButton}" Content="{DynamicResource S.Cancel}" Margin="0,0,10,0" Click="OnDialogCancel" />
                        <Button x:Name="DialogOk" Style="{StaticResource PrimaryButton}" Padding="20,9" Click="OnDialogOk" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
